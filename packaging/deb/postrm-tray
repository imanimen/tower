#!/bin/sh
set -e

case "$1" in
  remove|purge)
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications || true
    fi
    # Rendered icon frames are a cache, and live in each user's
    # $XDG_CACHE_HOME/tower — a package script must not reach into homes.
    # To clear them yourself:  rm -rf ~/.cache/tower
    ;;
esac

exit 0
